[Unit]
Description=Vautoshiftd minimal keyboard remapper
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/vautoshiftd
ExecStart=/bin/sh -c '/usr/lib/vautoshiftd/vautoshiftd ${VAUTOSHIFTD_ARGS:?Set VAUTOSHIFTD_ARGS in /etc/default/vautoshiftd}'
NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
